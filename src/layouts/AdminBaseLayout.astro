---
import '../styles/tokens.css';
import '../styles/admin.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Nalaro Project Desk', description = 'Internal project, invoice, and receipt workspace for Nalaro.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon-project-desk.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
